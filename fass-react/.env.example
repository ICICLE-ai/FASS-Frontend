VITE_API_BASE_URL=

# Tapis OAuth2 sign-in (ICICLE deployment uses Tapis as the IdP).
# VITE_TAPIS_BASE_URL defaults to https://icicle.tapis.io when unset.
# VITE_TAPIS_CLIENT_ID is required for the sign-in button to work; it is
# issued by whoever owns Tapis client registration on the ICICLE tenant
# (TBD contact, routed via Alfonso -- see PR #104 / FEAST issue #223).
# Christian must register this app's callback_url as
#   <this app's origin>/oauth/callback
# for both the dev origin (http://localhost:5173) and the deployed origin.
VITE_TAPIS_BASE_URL=https://icicle.tapis.io
VITE_TAPIS_CLIENT_ID=